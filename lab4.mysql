CREATE DATABASE IF NOT EXISTS office_expenses_group_db;
USE office_expenses_group_db;

CREATE TABLE departments (
    department_id INT AUTO_INCREMENT PRIMARY KEY,
    department_name VARCHAR(100) NOT NULL,
    employees_count INT,
    monthly_norm DECIMAL(10, 2)
);

CREATE TABLE expense_types (
    expense_type_id INT AUTO_INCREMENT PRIMARY KEY,
    type_name VARCHAR(100) NOT NULL,
    description TEXT,
    monthly_limit DECIMAL(10, 2)
);

CREATE TABLE expenses (
    expense_id INT AUTO_INCREMENT PRIMARY KEY,
    department_id INT,
    expense_type_id INT,
    employee_name VARCHAR(100),
    expense_date DATE NOT NULL,
    amount DECIMAL(10, 2) NOT NULL,
    FOREIGN KEY (department_id) REFERENCES departments(department_id),
    FOREIGN KEY (expense_type_id) REFERENCES expense_types(expense_type_id)
);

